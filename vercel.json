{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "landing": {
      "root": "landing"
    },
    "client": {
      "root": "client",
      "framework": "vite"
    },
    "server": {
      "root": "server",
      "framework": "express"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/socket.io(.*)",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/dashboard(.*)",
      "destination": {
        "service": "client"
      }
    },
    {
      "source": "/",
      "destination": {
        "service": "landing"
      }
    }
  ]
}

# Where the backend runs. Leave empty for local development (the Vite dev server proxies /api and
# /socket.io to localhost:4000). On Vercel, set this in Project Settings > Environment Variables
# to the Render URL, then redeploy: Vite reads it at build time.
VITE_API_URL=
# VITE_API_URL=https://fleetwake.onrender.com

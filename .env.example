# Server
PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/fleetwake
JWT_SECRET=change-me-to-a-long-random-string
# Shared secret that simulated devices send in the x-api-key header
DEVICE_API_KEY=dev-device-key
# Comma-separated origins allowed to call the API in development
CORS_ORIGINS=http://localhost:5173

# Pipeline tuning
BROADCAST_MS=250
FLUSH_MS=1000
MAX_PENDING_WRITES=100000
DEVICE_RATE_PER_SEC=5
DEVICE_BURST=20
# Long-idle rule threshold. 900 s (15 min) matches the landing page; lower it for a demo.
IDLE_ALERT_SEC=900
TELEMETRY_TTL_DAYS=7

# Set to a number to run the simulator inside the server process (handy for a one-service demo)
SIMULATE_VEHICLES=

# Simulator (simulator/index.js reads these too; CLI flags override)
SIM_URL=http://localhost:4000
SIM_VEHICLES=300
